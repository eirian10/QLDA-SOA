@model WebClient.Models.StudentViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Sinh Viên";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-custom p-4">
            <h6 class="fw-bold text-dark mb-3">Chỉnh sửa thông tin sinh viên</h6>

            <form asp-action="Edit" method="post">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Mã sinh viên</label>
                    <input type="text" asp-for="StudentId" class="form-control form-control-sm bg-light" readonly />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label small text-secondary">Họ đệm</label>
                        <input type="text" asp-for="LastName" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-5">
                        <label class="form-label small text-secondary">Tên</label>
                        <input type="text" asp-for="FirstName" class="form-control form-control-sm" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Lớp</label>
                    <input type="text" asp-for="ClassName" class="form-control form-control-sm" required />
                </div>
                <div class="mb-4">
                    <label class="form-label small text-secondary">Email</label>
                    <input type="email" asp-for="Email" class="form-control form-control-sm" required />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-light btn-sm px-3">Hủy</a>
                    <button type="submit" class="btn btn-navy btn-sm px-4">Lưu lại</button>
                </div>
            </form>
        </div>
    </div>
</div>