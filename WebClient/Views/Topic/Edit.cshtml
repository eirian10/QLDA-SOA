@model WebClient.Models.TopicViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Đề Tài";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-custom p-4">
            <h6 class="fw-bold text-dark mb-3">Chỉnh sửa thông tin đề tài</h6>

            <form asp-action="Edit" method="post">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Mã đề tài</label>
                    <input type="text" asp-for="TopicId" class="form-control form-control-sm bg-light" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Tên đề tài</label>
                    <input type="text" asp-for="Title" class="form-control form-control-sm" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Giảng viên hướng dẫn</label>
                    <input type="text" asp-for="Supervisor" class="form-control form-control-sm" required />
                </div>
                <div class="mb-4">
                    <label class="form-label small text-secondary">Trạng thái</label>
                    <select asp-for="Status" class="form-select form-select-sm">
                        <option value="Available">Available (Còn trống)</option>
                        <option value="Registered">Registered (Đã đăng ký)</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-light btn-sm px-3">Hủy</a>
                    <button type="submit" class="btn btn-navy btn-sm px-4">Lưu lại</button>
                </div>
            </form>
        </div>
    </div>
</div>